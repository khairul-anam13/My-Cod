PORT=4000
WEB_ORIGIN=http://localhost:3000

# From your Supabase Cloud project — Settings > API.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Nominatim (free OSM geocoding) requires an identifying User-Agent — put a
# real contact (app URL or email) here. https://operations.osmfoundation.org/policies/nominatim/
NOMINATIM_USER_AGENT=MyCOD/1.0 (contact: you@example.com)

# GPS-trust heuristic thresholds (advisory-only, see src/lib/locationTrust.ts). Optional — defaults shown.
LOCATION_TRUST_MAX_IP_MISMATCH_KM=150
LOCATION_TRUST_MAX_SPEED_KMH=300

# WhatsApp OTP for phone verification (src/lib/whatsapp.ts, via Baileys — an
# unofficial WhatsApp Web client). Leave "false" until you're ready to pair a
# sender number: set true, restart the API, and scan the QR code it prints.
WHATSAPP_OTP_ENABLED=false
